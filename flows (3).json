    {
        "id": "f6ce3acbaf7092a8",
        "type": "function",
        "z": "c8d9d9dd14dee73e",
        "name": "function 2",
        "func": "delete msg.topic;\nvar d = msg.payload || {};\n\nvar tempVal = (d.temperature_c !== null && d.temperature_c !== undefined) ? d.temperature_c : 0;\nvar humVal  = (d.humidity_pct !== null && d.humidity_pct !== undefined) ? d.humidity_pct : 0;\nvar vibVal  = d.vibration_rms || 0;\nvar currVal = d.current_a || 0;\nvar stateStr = d.motor_on ? \"RUNNING\" : \"STOPPED\";\nvar healthStr = d.ei_prediction || \"HEALTHY\";\n\nmsg.payload = {\n    motor_on: d.motor_on,\n    voltage_v: d.voltage_v || 0,\n    current_a: currVal,\n    power_w: d.power_w || 0,\n    temperature_c: tempVal,\n    humidity_pct: humVal,\n    vibration_rms: vibVal,\n    dominant_freq_hz: d.dominant_freq_hz || 0,\n    spectral_energy: d.spectral_energy || 0,\n    ei_prediction: healthStr,\n    fault_probability: d.fault_probability || 0,\n    fault_reason: d.fault_reason || \"NONE\",\n\n    temperature: tempVal,\n    Temperature: tempVal,\n    temp: tempVal,\n    TEMP: tempVal,\n\n    humidity: humVal,\n    Humidity: humVal,\n    humidit: humVal,\n\n    vibration: vibVal,\n    Vibration: vibVal,\n\n    current: currVal,\n    Current: currVal,\n    CURRENT: currVal,\n\n    state: stateStr,\n    State: stateStr,\n    STATE: stateStr,\n    status: stateStr,\n    operational_state: stateStr,\n\n    health: healthStr,\n    Health: healthStr,\n    HEALTH: healthStr\n};\n\n// Fault check\nvar faultReason = msg.payload.fault_reason;\nvar faultProbability = Number(msg.payload.fault_probability || 0);\n\nvar isFault =\n    (healthStr !== \"HEALTHY\" && healthStr !== \"NORMAL\") ||\n    (faultReason !== \"NONE\" && faultReason !== \"\") ||\n    faultProbability >= 0.7;\n\nvar telegramMsg = null;\nvar gmailMsg = null;\n\nif (isFault) {\n    // 1. Telegram Alert\n    telegramMsg = {\n        payload: {\n            chatId: \"1212440511\", // حط الـ Chat ID بتاعك هنا\n            type: \"message\",\n            content: \n                \"⚠️ MACHINE FAULT ALERT\\n\\n\" +\n                \"🏭 Machine: M01\\n\" +\n                \"⚙️ State: \" + stateStr + \"\\n\" +\n                \"🩺 Health: \" + healthStr + \"\\n\" +\n                \"🔎 Fault: \" + faultReason + \"\\n\" +\n                \"📊 Fault Probability: \" + faultProbability + \"\\n\" +\n                \"🌡️ Temperature: \" + tempVal + \" °C\\n\" +\n                \"💧 Humidity: \" + humVal + \" %\\n\" +\n                \"📳 Vibration: \" + vibVal + \"\\n\" +\n                \"⚡ Current: \" + currVal + \" A\"\n        }\n    };\n\n    // 2. Gmail Alert\n    gmailMsg = {\n        to: \"sherymegally@gmail.com\",\n        topic: \"CRITICAL MACHINE FAULT ALERT - M01\",\n        payload: \n            \"CRITICAL MACHINE FAULT DETECTED\\n\\n\" +\n            \"Machine: M01\\n\" +\n            \"State: \" + stateStr + \"\\n\" +\n            \"Health: \" + healthStr + \"\\n\" +\n            \"Fault Reason: \" + faultReason + \"\\n\" +\n            \"Fault Probability: \" + faultProbability + \"\\n\\n\" +\n            \"Sensor Readings:\\n\" +\n            \"- Temperature: \" + tempVal + \" °C\\n\" +\n            \"- Humidity: \" + humVal + \" %\\n\" +\n            \"- Vibration: \" + vibVal + \"\\n\" +\n            \"- Current: \" + currVal + \" A\"\n    };\n    \n    return [msg, telegramMsg, gmailMsg];\n} else {\n    return [msg, null, null];\n}",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
