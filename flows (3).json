    {
        "id": "60b2f311ffd05885",
        "type": "function",
        "z": "c8d9d9dd14dee73e",
        "name": "on/off",
        "func": "// التأكد من وصول رسالة صحيحة\nif (!msg.topic || !msg.payload) {\n    return null;\n}\n\n// استخراج رقم الطلب والبيانات\nvar requestId = msg.topic.slice(\"v1/devices/me/rpc/request/\".length);\nvar method = msg.payload.method;\nvar params = msg.payload.params;\n\nvar currentMotorState = context.get('motorState') || false;\n\n// 1. عند فتح الداشبورد: الرد على استعلام الحالة (getState)\nif (method === \"getState\") {\n    // نرسل الرد إلى ThingsBoard عبر المخرج الثاني فقط\n    return [null, {\n        topic: \"v1/devices/me/rpc/response/\" + requestId,\n        payload: currentMotorState\n    }];\n}\n\n// 2. عند الضغط على زر التشغيل أو الإيقاف (setState)\nif (method === \"setState\") {\n    context.set('motorState', params);\n\n    // [المخرج 1 - الأعلى]: يذهب حصراً إلى HiveMQ للراسبيري\n    var motorCmdMsg = {\n        topic: \"gradproject/motor/cmd\",\n        payload: {\n            state: params ? 1 : 0,\n            command: params ? \"ON\" : \"OFF\"\n        }\n    };\n\n    // [المخرج 2 - الأسفل]: يذهب حصراً إلى ThingsBoard كتأكيد\n    var tbResponseMsg = {\n        topic: \"v1/devices/me/rpc/response/\" + requestId,\n        payload: params\n    };\n\n    return [motorCmdMsg, tbResponseMsg];\n}\n\nreturn null;",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1130,
        "y": 780,
        "wires": [
