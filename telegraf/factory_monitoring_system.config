[[inputs.mqtt_consumer]]
  servers = ["ssl://f7559e3e38f94eb7bfc2906b6be26633.s1.eu.hivemq.cloud:8883"]
  topics = ["pdm_demo_x7k2/+/telemetry"]
  username = ""
  password = ""
  client_id = "telegraf_pdm_telemetry"
  qos = 0
  persistent_session = false
  data_format = "json"
  name_override = "machine_telemetry"
  tag_keys = ["machine"]
  json_string_fields = ["state", "level", "health"]


[[inputs.mqtt_consumer]]
  servers = ["ssl://f7559e3e38f94eb7bfc2906b6be26633.s1.eu.hivemq.cloud:8883"]
  topics = ["pdm_demo_x7k2/+/event"]
  username = ""
  password = ""
  client_id = "telegraf_pdm_events"
  qos = 0
  persistent_session = false
  data_format = "json"
  name_override = "machine_events"
  tag_keys = ["machine"]
  json_string_fields = [
    "type",
    "severity",
    "message",
    "action",
    "state"
  ]


[[outputs.influxdb_v2]]
